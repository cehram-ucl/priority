  3.         display "Reading worksheet: `sheet'"
  4.         import excel `filename'_raw_`clinician', firstrow clear sheet("`sheet'")
  5.         
.         keep medcodeid
  6.         generate byte `clinician' = 1
  7.         generate byte cholesterol_type = `count'
  8.         
.         if "`sheet'" != "`firstsheet'" {
  9.                 do `sheetlabels'
 10.         }
 11.         label define cholesterol_type `count' "`sheet'", add
 12.         label save using `sheetlabels', replace
 13.         
.         tempfile clinician`count'
 14.         save `clinician`count''
 15. }
